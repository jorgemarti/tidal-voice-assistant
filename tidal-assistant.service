[Unit]
Description=Tidal Voice Assistant
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=cockemc
Group=cockemc
WorkingDirectory=/home/cockemc/tidal-voice-assistant
Environment="PATH=/home/cockemc/tidal-voice-assistant/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Rotating log file next to the journal (5 x 5 MB): tail -f ~/tidal-voice-assistant/logs/assistant.log
Environment="LOG_FILE=logs/assistant.log"
Environment="PYTHONUNBUFFERED=1"

# Load environment variables (GEMINI_API_KEY, LASTFM_*, LOG_LEVEL)
EnvironmentFile=/home/cockemc/tidal-voice-assistant/.env

ExecStart=/home/cockemc/tidal-voice-assistant/venv/bin/python /home/cockemc/tidal-voice-assistant/main.py

# Restart always (arecord dying, Chromecast gone, unhandled errors)
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tidal-assistant

[Install]
WantedBy=multi-user.target
