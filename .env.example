# Logging Configuration (optional)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# - DEBUG: Verbose output (useful for development/troubleshooting)
# - INFO: Normal operation (recommended for production/systemd)
LOG_LEVEL=INFO

# Google Gemini API key (required when COMMAND_PARSER = 'gemini' in config.py)
# Used to parse the spoken command (audio only) into a structured intent.
# Create a key at https://aistudio.google.com/apikey. Gemini API billing is prepaid; a few euros last months.
# Without a key the assistant falls back to the regex parser on the local Vosk transcript.
GEMINI_API_KEY=

# Last.fm scrobbling (optional). Create an API account at https://www.last.fm/api/account/create,
# put the key and shared secret here, then run `python lastfm_auth.py` once to authorise the account.
LASTFM_API_KEY=
LASTFM_API_SECRET=
